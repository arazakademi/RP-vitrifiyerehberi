---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { render } from 'astro:content';
import { tumYazilar, tarihTR, okumaSuresi, kategoriEtiketi, type Yazi } from '../../lib';

export async function getStaticPaths() {
  const yazilar = await tumYazilar();
  return yazilar.map((y) => ({ params: { slug: y.id }, props: { yazi: y } }));
}

interface Props { yazi: Yazi }
const { yazi } = Astro.props;
const d = yazi.data;
const { Content } = await render(yazi);
const { k, a, metin } = kategoriEtiketi(yazi);
const dk = okumaSuresi(yazi.body);
const url = `https://vitrifiyerehberi.com/yazi/${yazi.id}`;
const ilgili = (await tumYazilar()).filter((y) => y.id !== yazi.id && y.data.kategori === d.kategori).slice(0, 3);

const jsonld: object[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.baslik,
    description: d.aciklama,
    image: new URL(d.gorsel, 'https://vitrifiyerehberi.com').href,
    datePublished: d.tarih.toISOString(),
    dateModified: d.tarih.toISOString(),
    articleSection: metin,
    wordCount: (yazi.body ?? '').split(/\s+/).filter(Boolean).length,
    author: { '@type': 'Organization', name: 'Vitrifiye Rehberi editör ekibi' },
    publisher: { '@type': 'Organization', name: 'Vitrifiye Rehberi' },
    mainEntityOfPage: url,
    inLanguage: 'tr',
    keywords: d.etiketler.join(', '),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Ana sayfa', item: 'https://vitrifiyerehberi.com/' },
      { '@type': 'ListItem', position: 2, name: k?.ad, item: `https://vitrifiyerehberi.com/kategori/${k?.slug}` },
      ...(a ? [{ '@type': 'ListItem', position: 3, name: a.ad, item: `https://vitrifiyerehberi.com/kategori/${k?.slug}/${a.slug}` }] : []),
      { '@type': 'ListItem', position: a ? 4 : 3, name: d.baslik, item: url },
    ],
  },
];
if (d.sss.length) {
  jsonld.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.sss.map((q) => ({ '@type': 'Question', name: q.s, acceptedAnswer: { '@type': 'Answer', text: q.c } })),
  });
}
---
<Base title={d.baslik} description={d.aciklama} image={d.gorsel} type="article" jsonld={jsonld}>
  <article>
    <header class="post-head narrow">
      <p class="eyebrow">
        <a href={`/kategori/${k?.slug}`}>{k?.ad}</a>{a && <> › <a href={`/kategori/${k?.slug}/${a.slug}`}>{a.ad}</a></>} · <time datetime={d.tarih.toISOString()}>{tarihTR(d.tarih)}</time>
      </p>
      <h1>{d.baslik}</h1>
      <p class="meta">Vitrifiye Rehberi editör ekibi · {dk} dk okuma</p>
    </header>
    <div class="post-hero"><img src={d.gorsel} alt={d.gorselAlt} fetchpriority="high" width="1200" height="750" /></div>
    <div class="narrow prose">
      {d.kisaca.length > 0 && (
        <aside class="kisaca" aria-labelledby="kisaca"><h2 id="kisaca">Kısaca</h2><ul>{d.kisaca.map((m) => <li>{m}</li>)}</ul></aside>
      )}
      <Content />
      {d.sss.length > 0 && (
        <section class="sss" aria-labelledby="sss">
          <h2 id="sss">Sık sorulan sorular</h2>
          {d.sss.map((q) => <><h3>{q.s}</h3><p>{q.c}</p></>)}
        </section>
      )}
      {d.urunler.length > 0 && (
        <aside class="urunler" aria-labelledby="urunler">
          <h2 id="urunler">Yazıdaki ürünler</h2>
          <ul>{d.urunler.map((u) => <li><a href={u.url} target="_blank" rel="noopener">{u.ad}</a></li>)}</ul>
        </aside>
      )}
      {d.etiketler.length > 0 && <ul class="chips tags" aria-label="Etiketler">{d.etiketler.map((t) => <li><span>{t}</span></li>)}</ul>}
      <p class="credit">Ürün fotoğrafları ve teknik bilgiler: <a href={k?.creavit} rel="nofollow noopener">Creavit</a> ürün sayfaları.</p>
    </div>
  </article>
  {ilgili.length > 0 && (
    <section class="wrap" aria-labelledby="ilgili">
      <h2 id="ilgili" class="section-title">İlgili yazılar</h2>
      <div class="post-grid">{ilgili.map((y) => <PostCard yazi={y} />)}</div>
    </section>
  )}
</Base>
